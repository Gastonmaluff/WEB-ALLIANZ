rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public website data
    match /properties/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // All other collections stay private
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
